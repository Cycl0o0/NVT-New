NVT_BACKEND_URL=http://127.0.0.1:8080
NVT_DEFAULT_NETWORK=bdx
NVT_REFRESH_MS=15000

# ── Apple MapKit JS ──────────────────────────────────────────────
# Preferred: server-side token minting (auto-refreshes, never expires on you).
# Get these from the Apple Developer portal (Maps IDs & Keys).
# MAPKIT_PRIVATE_KEY is the contents of the .p8 file (literal \n are accepted).
MAPKIT_PRIVATE_KEY=
MAPKIT_KEY_ID=
MAPKIT_TEAM_ID=
# Token lifetime in seconds (default 1800 = 30 min). MapKit refreshes before this.
MAPKIT_TOKEN_TTL=1800

# Fallback: a single pre-issued JWT. Static — stops working once it expires.
# Leave empty if you set the signing key above.
MAPKIT_JS_TOKEN=
